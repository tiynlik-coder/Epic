# Epic Mafia — nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring.

# Majburiy
BOT_TOKEN=

# Bot adminlari (Telegram ID, vergul bilan): 123456789,987654321
ADMIN_IDS=

# PostgreSQL. Bo'sh qolsa, epic_mafia.db (SQLite) ishlatiladi.
DATABASE_URL=postgresql://epic:PAROL@localhost:5432/epic_mafia
# Redis — restartdan keyin o'yinlarni tiklash uchun. Bo'sh qolsa, epic_mafia_state.json.
REDIS_URL=redis://localhost:6379/0

# Kanal (@username). Obunachilarga 2x mukofot. Bo'sh = kanal bonusi yo'q.
CHANNEL_USERNAME=
# Tugmalar uchun havolalar (ixtiyoriy)
CHANNEL_URL=
SUPPORT_URL=
PREMIUM_URL=

# Katta xaridlar/o'tkazmalar haqida hisobot boradigan guruh ID (ixtiyoriy)
REPORT_CHAT_ID=
# Olmosni qo'lda sotuvchi admin havolasi (ixtiyoriy): https://t.me/username
DIAMOND_SELLER_URL=
